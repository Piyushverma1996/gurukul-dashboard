# Copy to .env.local for local dev. Production values live in Hostinger → dashboard.gurukulfc.com → Environment variables
# (see docs/deploy/hostinger-runbook.md). Never commit real secrets.

# Local: the db:dev throwaway server. Production: mysql://u792094516_gurukul:<password>@127.0.0.1:3306/u792094516_gurukul
# (use 127.0.0.1, not localhost: Node 22 tries IPv6 first and Hostinger's MariaDB refuses it)
DATABASE_URL=mysql://root@127.0.0.1:3307/gurukul
BETTER_AUTH_SECRET=replace-with-32+-random-characters
BETTER_AUTH_URL=http://localhost:3000
CRON_SECRET=replace-with-random-string
APP_TIMEZONE=Asia/Kolkata

# Optional locally. "Sign in with Google" shows only when these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional locally. Google Sheet sync: base64 of the service-account key file, and the sheet ID from its URL.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# Only for `npm run db:seed` (first admin). Not needed at runtime.
SEED_ADMIN_NAME=Sharan
SEED_ADMIN_EMAIL=shrigurshalagurukul@gmail.com
SEED_ADMIN_PHONE=+919625573511
SEED_ADMIN_PASSWORD=replace-with-temporary-password
